[Unit]
Description=Raspberry Pi Network Activity and Packet-Drop LEDs
After=local-fs.target

[Service]
Type=simple
EnvironmentFile=/etc/default/txrx-led
ExecStart=/usr/bin/python3 /usr/local/bin/txrx_led.py
Restart=on-failure
RestartSec=2
User=root
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
